    <string name="boss_balrog_name">炎魔</string>

    <!-- ===== 宠物名称和描述 ===== -->
    <string name="pet_dragon_whelp_name">幼龙</string>
    <string name="pet_dragon_whelp_desc">一条幼龙，能提升你的战斗经验值。</string>
    <string name="pet_imp_pet_name">小鬼宠物</string>
    <string name="pet_imp_pet_desc">一只淘气的小鬼，能增强你的祈祷训练效果。</string>
    <string name="pet_baby_kraken_name">小海妖</string>
    <string name="pet_baby_kraken_desc">一只小海妖，能提升你的烹饪经验值。</string>
    <string name="pet_rock_golem_name">岩石魔像</string>
    <string name="pet_rock_golem_desc">一个活化的岩石构造体，能提升你的采矿经验值。</string>
    <string name="pet_ent_name">树人</string>
    <string name="pet_ent_desc">一个古老的树灵，能提升你的伐木经验值。</string>
    <string name="pet_tiny_templar_name">小圣骑士</string>
    <string name="pet_tiny_templar_desc">一条小鱼伙伴，能提升你的钓鱼经验值。</string>
    <string name="pet_tangleroot_name">缠根怪</string>
    <string name="pet_tangleroot_desc">一种魔法植物生物，能提升你的种植经验值。</string>

    <string name="dungeon_collapsed_mine_name">坍塌矿井</string>
    <string name="dungeon_collapsed_mine_desc">铜矿下方的巨大洞穴。洞穴巨魔和岩石魔像出没于废墟之间，巨型蜘蛛在坍塌的矿道中织满蛛网。</string>
    <string name="dungeon_shadow_den_name">暗影巢穴</string>
    <string name="dungeon_shadow_den_desc">该地区盗贼公会使用的地下密室网络。盗贼、刺客和暗影生物潜伏在每个角落。</string>
    <string name="dungeon_abyssal_ruins_name">深渊废墟</string>
    <string name="dungeon_abyssal_ruins_desc">同时存在于凡间之上和之下的远古废墟。奇异的深渊生物在现实中时隐时现。</string>
    <string name="dungeon_ancient_forest_ruins_name">远古森林废墟</string>
    <string name="dungeon_ancient_forest_ruins_desc">被原始森林吞噬的石质废墟，如今被野性生物和德鲁伊的复仇之灵所占据。</string>
    <string name="dungeon_ancient_forge_name">远古锻造厂</string>
    <string name="dungeon_ancient_forge_desc">一座燃烧了数百年未曾熄灭的巨大矮人锻造厂。火焰元素和锻造守卫守护着它的秘密。</string>
    <string name="dungeon_arcane_ruins_name">奥术废墟</string>
    <string name="dungeon_arcane_ruins_desc">一座被摧毁的法师塔中仍在运作的地下密室。魔法构装体和附魔守卫仍在其中巡逻。</string>
    <string name="dungeon_corrupted_sanctum_name">腐化圣所</string>
    <string name="dungeon_corrupted_sanctum_desc">位于腐化林冠深处的阴暗圣所。暗黑祭司和腐化野兽守护着一个远古邪物。</string>
    <string name="dungeon_drowned_temple_name">沉没神殿</string>
    <string name="dungeon_drowned_temple_desc">海窟下方一座沉入海底的神殿，殿堂中灌满了海水，海洋生物已将其据为家园。</string>
</resources>
