    <!-- ===== 地下城名称和描述 ===== -->
    <string name="dungeon_imp_cavern_name">小鬼洞穴</string>
    <string name="dungeon_imp_cavern_desc">一个满是淘气小鬼的浅洞穴。非常适合新手入门！</string>
    <string name="dungeon_goblin_cave_name">哥布林洞穴</string>
    <string name="dungeon_goblin_cave_desc">一个被哥布林和巨鼠占据的黑暗洞穴。新冒险者练级的好去处。</string>
    <string name="dungeon_spider_den_name">蜘蛛巢穴</string>
    <string name="dungeon_spider_den_desc">一个蛛网密布、毒蜘蛛横行的洞穴。记得带解毒药！</string>
    <string name="dungeon_bandit_camp_name">强盗营地</string>
    <string name="dungeon_bandit_camp_desc">荒野中盗贼和流氓的藏身之处。看好你的钱袋！</string>
    <string name="dungeon_undead_crypt_name">亡灵地穴</string>
    <string name="dungeon_undead_crypt_desc">亡者拒绝安息的古老墓地。小心暗黑魔法！</string>
    <string name="dungeon_fortress_ruins_name">要塞废墟</string>
    <string name="dungeon_fortress_ruins_desc">一座古老城堡的残垣断壁，如今由骑士和士兵把守。</string>
    <string name="dungeon_orc_stronghold_name">兽人堡垒</string>
    <string name="dungeon_orc_stronghold_desc">深山中一座坚固的兽人营地。只有勇者才敢踏入。</string>
    <string name="dungeon_volcanic_depths_name">火山深渊</string>
    <string name="dungeon_volcanic_depths_desc">一个地狱犬和低阶恶魔栖息的灼热洞穴。酷热难耐！</string>
    <string name="dungeon_dragon_lair_name">龙巢</string>
    <string name="dungeon_dragon_lair_desc">绿龙传说中的栖息之地。只有大师级战士才能在此生还。</string>
    <string name="dungeon_farm_name">农场</string>
    <string name="dungeon_farm_desc">一座有家畜的宁静农场。非常适合新手收集食物！</string>
    <string name="dungeon_infernal_stronghold_name">地狱要塞</string>
    <string name="dungeon_infernal_stronghold_desc">一座烈火与硫磺的要塞，由恶魔和地狱犬统治。光是高温就能杀死毫无准备的人。</string>
    <string name="dungeon_ancient_temple_name">远古神殿</string>
    <string name="dungeon_ancient_temple_desc">一座由大陆最强生物把守的远古神殿。只有最强的战士才敢进入。</string>

